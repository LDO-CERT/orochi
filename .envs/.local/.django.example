# General
# ------------------------------------------------------------------------------
USE_DOCKER=yes
IPYTHONDIR=/app/.ipython
DJANGO_SETTINGS_MODULE=config.settings.production

# Django
# ------------------------------------------------------------------------------
# Required. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Comma separated list of previous keys, used only while rotating DJANGO_SECRET_KEY
DJANGO_SECRET_KEY_FALLBACKS=
ALLOWED_HOSTS=localhost,127.0.0.1,django,orochi.dev

# Smtp
# ------------------------------------------------------------------------------
DJANGO_EMAIL_BACKEND='django.core.mail.backends.smtp.EmailBackend'
EMAIL_HOST='mailpit'
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_HOST_USER=''
EMAIL_HOST_PASSWORD=''
DEFAULT_FROM_EMAIL='noreply@localhost'
SERVER_EMAIL='noreply@localhost'
# Comma separated addresses that receive error reports
ADMINS_EMAIL='admin@localhost'
EMAIL_TIMEOUT=30

# Redis
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_SERVER=redis
REDIS_PORT=6379

# Dask
# ------------------------------------------------------------------------------
DASK_SCHEDULER_URL=tcp://scheduler:8786

# Orochi
# ------------------------------------------------------------------------------
# THREAD_NO, AWESOME_PATH, DEFAULT_YARA_RULE_PATH, VOLATILITY_SYMBOL_DOWNLOAD_PATH, VOLATILITY_REMOTE_ISF_URL,
# REGIPY_PLUGINS, STORAGE_CACHE_MAX_GB and AUTO_RESOLVE_SYMBOLS are only INITIAL values: after the first migrate
# change them in Admin > Extra settings (they apply without restart).
THREAD_NO=10
AWESOME_PATH=https://raw.githubusercontent.com/InQuest/awesome-yara/master/README.md
LOCAL_YARA_PATH=/yara
DEFAULT_YARA_RULE_PATH=/yara/default.yara
VOLATILITY_SYMBOL_DOWNLOAD_PATH=https://github.com/volatilityfoundation/volatility3-test-data/releases/download/v0.0.1/
# Folder listed by "From server folder" in the upload dialog (bind-mounted from the host,
# ./uploads by default: set LOCAL_UPLOAD_HOST_PATH in the shell or .env to use another host folder)
LOCAL_UPLOAD_PATH=/uploads
# Remote banners index for on-demand Linux/Mac ISF (empty to disable, e.g. air-gapped)
VOLATILITY_REMOTE_ISF_URL=https://github.com/Abyss-W4tcher/volatility3-symbols/raw/master/banners/banners.json

# Remote dump storage (experimental, needs django-storages[s3] in the images)
USE_S3_STORAGE=False
# AWS_STORAGE_BUCKET_NAME=orochi-dumps
# AWS_S3_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_REGION_NAME=us-east-1
# Local cache of remote dumps, evicted least recently used above this size (0 = never)
# STORAGE_CACHE_MAX_GB=0
# DEFAULT_FILE_STORAGE_BACKEND=storages.backends.s3.S3Storage
# Azure Blob instead of S3 (needs django-storages[azure] in the images)
# USE_AZURE_STORAGE=False
# AZURE_ACCOUNT_NAME=
# AZURE_ACCOUNT_KEY=
# AZURE_CONNECTION_STRING=
# AZURE_CONTAINER=orochi-dumps
# AI narratives accept only local/private model endpoints unless this is True
# LLM_ALLOW_REMOTE_ENDPOINT=False
REGIPY_PLUGINS=computer_name,host_domain_name,network_drives_plugin
# Paths inside the containers (defaults shown)
# DJANGO_MEDIA_ROOT=/media
# VOLATILITY_SYMBOL_PATH=/symbols
# VOLATILITY_PLUGIN_PATH=/plugins
# Initial value of the AUTO_RESOLVE_SYMBOLS Extra Setting: download debug packages and build the ISF
# of unknown Linux kernels automatically (needs Internet access)
# AUTO_RESOLVE_SYMBOLS=False

# Debug
# ------------------------------------------------------------------------------
DEBUG_LEVEL=WARNING
# Log level of Orochi's own loggers (default: DEBUG_LEVEL)
# OROCHI_LOG_LEVEL=INFO
# Use config.settings.development for DEBUG, debug toolbar and django-extensions
# DJANGO_DEBUG=False

# Https
# ------------------------------------------------------------------------------
HTTPS=False
# With HTTPS=True: seconds browsers must keep using HTTPS (0 = off; enable once HTTPS is stable)
# SECURE_HSTS_SECONDS=0
# Allow passkeys over plain HTTP (development only)
# MFA_WEBAUTHN_ALLOW_INSECURE_ORIGIN=False

# Ldap
# ------------------------------------------------------------------------------
AUTH_LDAP_SERVER_URI=
AUTH_LDAP_BIND_DN=
AUTH_LDAP_BIND_PASSWORD=
AUTH_LDAP_USER_SEARCH_DN=
AUTH_LDAP_USER_SEARCH_ALIAS=
AUTH_LDAP_USER_ATTR_MAP=

# Proxy
# ------------------------------------------------------------------------------
http_proxy=
https_proxy=
no_proxy=

# CSRF_TRUSTED_ORIGINS
# ------------------------------------------------------------------------------
CSRF_TRUSTED_ORIGINS=https://localhost,http://localhost,https://127.0.0.1,http://127.0.0.1,https://orochi.dev,http://localhost:8000

# AUTH
# ------------------------------------------------------------------------------
DJANGO_ACCOUNT_ALLOW_REGISTRATION=False
ACCOUNT_EMAIL_VERIFICATION=optional
ACCOUNT_SIGNUP_FIELDS=username*,email,password1*,password2*
