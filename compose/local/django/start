#!/bin/bash

set -o errexit
set -o pipefail
set -o nounset

python manage.py migrate --noinput

if [ "${TAILWIND_REBUILD:-1}" = "1" ] || [ ! -f /app/orochi/static/css/tailwind_dist.css ]; then
    if [ -f /app/orochi/static/css/tailwind_dist.css ]; then
        cp -p /app/orochi/static/css/tailwind_dist.css /tmp/tw_prev.css
    fi
    python manage.py tailwind build --skip-checks
    if [ -f /tmp/tw_prev.css ] && cmp -s /tmp/tw_prev.css /app/orochi/static/css/tailwind_dist.css; then
        mv -f /tmp/tw_prev.css /app/orochi/static/css/tailwind_dist.css
    else
        rm -f /tmp/tw_prev.css
    fi
fi

if [ "${COLLECTSTATIC_ON_START:-0}" = "1" ] || [ ! -f /app/staticfiles/.collectstatic.stamp ] || [ -n "$(find /app/orochi/static -type f -newer /app/staticfiles/.collectstatic.stamp -print -quit 2>/dev/null)" ]; then
    python manage.py collectstatic --skip-checks --noinput
    touch /app/staticfiles/.collectstatic.stamp
fi

if [ "${TAILWIND_WATCH:-0}" = "1" ]; then
    python manage.py tailwind watch &
fi

gunicorn config.wsgi:application --workers=2 --timeout 7200 -b :8000
